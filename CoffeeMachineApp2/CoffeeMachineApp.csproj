<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>CoffeeMachineApp</RootNamespace>
    <AssemblyName>CoffeeMachineApp</AssemblyName>
  </PropertyGroup>

  <!-- Картинки из папки Assets копируются рядом с .exe -->
  <ItemGroup>
    <None Update="Assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets/*.png" LogicalName="CoffeeMachineApp.Assets.%(Filename)%(Extension)" />
    <Compile Update="Forms/CoffeeMachineControl.cs"><SubType>UserControl</SubType></Compile>
    <Compile Update="Forms/MainForm.cs"><SubType>Form</SubType></Compile>
    <Compile Update="Forms/Modules/*Control.cs"><SubType>UserControl</SubType></Compile>
    <Compile Update="Forms/**/*.Designer.cs"><DependentUpon>$([System.String]::Copy('%(Filename)').Replace('.Designer', '')).cs</DependentUpon></Compile>
  </ItemGroup>

</Project>

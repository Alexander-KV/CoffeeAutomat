<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <!-- Тестируем те же исходники без зависимости от Windows Forms и сторонних пакетов. -->
  <ItemGroup>
    <Compile Include="../CoffeeMachineApp2/Models/*.cs" Link="Models/%(Filename)%(Extension)" />
    <Compile Include="../CoffeeMachineApp2/Storage/*.cs" Link="Storage/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
